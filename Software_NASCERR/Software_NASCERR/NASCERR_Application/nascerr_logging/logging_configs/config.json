{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "[%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s",
      "datefmt": "%d/%m/%Y %H:%M:%S %z"
    },
    "json": {
      "()": "nascerr_logging.mylogger.MyJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "message": "message",
        "timestamp": "timestamp",
        "logger": "name",
        "module": "module",
        "function": "funcName",
        "line": "lineno",
        "thread_name": "threadName"
      }
    }
  },
  "filters": {
    "info_and_below": {
      "()": "nascerr_logging.mylogger.NonErrorFilter"
    },
    "nascerr_only": {
      "()": "nascerr_logging.mylogger.NascerrFilter"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "simple",
      "stream": "ext://sys.stdout",
      "filters": ["info_and_below"]
    },
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "WARNING",
      "formatter": "simple",
      "stream": "ext://sys.stderr"
    },
    "file_json": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "nascerr_logging/logs/nascerr.log.jsonl",
      "maxBytes": 100000,
      "backupCount": 3,
      "encoding": "utf-8",
      "filters":  ["nascerr_only"]
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["stdout", "stderr", "file_json"]
  }
}